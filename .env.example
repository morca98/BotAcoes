# Stock Signal Bot MTF V3 — Environment Variables
# Copia este ficheiro para .env e preenche os valores

# ── Telegram ──────────────────────────────────────────────────────────────────
# Obtém o token em @BotFather no Telegram
TELEGRAM_TOKEN=COLOQUE_O_TOKEN_DO_BOTFATHER_AQUI

# O teu Chat ID (usa @userinfobot para o obter)
TELEGRAM_CHAT_ID=COLOQUE_O_CHAT_ID_AQUI

# ── Capital ───────────────────────────────────────────────────────────────────
# Capital total em euros (ajusta conforme a tua conta)
CAPITAL=10000
